# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- GitHub auto-sync (local only, không commit file .env) ---
# Personal Access Token: GitHub → Settings → Developer settings → Fine-grained tokens
# Quyền: Contents (Read and write) trên repo chd-management-webapp-5
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
# Ví dụ: https://github.com/hieubt1710/chd-management-webapp-5.git
GITHUB_REPO="https://github.com/anbui1510/CHD-management-webapp-5.git"
# Nhánh đồng bộ (mặc định main)
GITHUB_BRANCH="main"
# Khoảng cách auto-sync (giây), dùng bởi npm run sync:github:watch
GITHUB_SYNC_INTERVAL="300"

# Tên/email hiển thị trên commit (phải khớp tài khoản GitHub — tránh lỗi Vercel deploy)
GIT_COMMITTER_NAME="anbui1510"
GIT_COMMITTER_EMAIL="your-github-email@example.com"

# --- CHD Daily Brief ---
PUBMED_EMAIL="your-email@hospital.vn"
PUBMED_TOOL="chd-daily-brief"
CHD_BRIEF_AUTO_ENABLED="true"
# Free tier (2026): dùng gemini-2.5-flash hoặc gemini-2.5-flash-lite — gemini-2.0-flash đã limit 0
GEMINI_MODEL="gemini-2.5-flash"

# --- Cloudflare Pages (CHD Daily Brief API) ---
# Thêm trong Cloudflare Dashboard → Settings → Variables and Secrets (Runtime):
# GEMINI_API_KEY (Secret), GEMINI_MODEL=gemini-2.5-flash (Variable), PUBMED_EMAIL, PUBMED_TOOL
