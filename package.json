{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "setup:vapid-env": "node scripts/setup-vapid-env.mjs",
    "prebuild": "node scripts/generate-apps-script-prompt-block.mjs && node scripts/extract-apps-script.mjs && node scripts/ensure-cloudflare-push-setup.mjs",
    "postbuild": "node scripts/ensure-cloudflare-sync-config.mjs",
    "setup:cloudflare-push": "node scripts/ensure-cloudflare-push-setup.mjs",
    "clean": "rm -rf dist server.js data",
    "lint": "tsc --noEmit",
    "extract:apps-script": "node scripts/generate-apps-script-prompt-block.mjs && node scripts/extract-apps-script.mjs",
    "sync:github:init": "bash scripts/github-init.sh",
    "sync:github": "bash scripts/github-sync.sh",
    "sync:github:watch": "bash scripts/github-auto-sync.sh",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.4.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "web-push-browser": "^1.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.113.0"
  }
}
